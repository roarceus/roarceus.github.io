{
  "$comment": "Lighthouse CI budgets (SPEC §10 Tests), shared by CI (pnpm lhci, against dist/) and the weekly production check (--collect.url). Default form factor is mobile with throttling. CI audits the URLs below on the local dist/ server (lhci swaps in its port); the weekly check passes the production URL instead. The 404 and thank-you pages are noindex on purpose, which always fails Lighthouse's is-crawlable audit, so for them the SEO category is replaced by its other audits; every other budget is the same.",
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/plain/index.html",
        "http://localhost/projects/asktrace/index.html",
        "http://localhost/updates/index.html",
        "http://localhost/404.html"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*(?:/404\\.html|/contact/thanks/)).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "(?:/404\\.html|/contact/thanks/)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
