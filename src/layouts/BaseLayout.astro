---
import '@/styles/global.css';

import SeoHead from '@/components/layout/SeoHead.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import TopBar from '@/components/layout/TopBar.astro';
import { site } from '@/config/site';
import { url } from '@/lib/utils/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Adds the schema.org Person JSON-LD. */
  person?: boolean;
  noindex?: boolean;
  /** Which view this page is, for the top bar's view switch. */
  view?: 'cluster' | 'plain' | 'page';
  /** Lets the top bar and footer grow with a full-width page (the cluster dashboard). */
  wide?: boolean;
  /** On large screens the page fills the window instead of scrolling (the `desk` variant). */
  fill?: boolean;
}

const {
  title = `${site.name} | ${site.title}`,
  description = site.description,
  type = 'website',
  person = false,
  noindex = false,
  view = 'page',
  wide = false,
  fill = false,
} = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={site.themeColor} />
    <SeoHead title={title} description={description} type={type} person={person} noindex={noindex} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <slot name="head" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: updates`} href={url('rss.xml')} />
  </head>
  <body data-shell={fill ? 'fill' : undefined}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <TopBar view={view} wide={wide} />
    <slot />
    <SiteFooter wide={wide} />
  </body>
</html>
