---
import '@/styles/global.css';

import SeoHead from '@/components/layout/SeoHead.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import TopBar from '@/components/layout/TopBar.astro';
import { site } from '@/config/site';
import { url } from '@/lib/utils/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Adds the schema.org Person JSON-LD. */
  person?: boolean;
  noindex?: boolean;
  /** Which view this page is, for the top bar's view switch. */
  view?: 'cluster' | 'plain' | 'page';
}

const {
  title = `${site.name} | ${site.title}`,
  description = site.description,
  type = 'website',
  person = false,
  noindex = false,
  view = 'page',
} = Astro.props;

// GitHub Pages can't set headers, so the CSP ships as a meta tag (SPEC §10b). Production only:
// the dev server injects inline scripts and styles. The only off-site endpoint is the contact
// form's (Web3Forms): fetch from the script, or a plain form post without JavaScript.
const contactOrigin = new URL(site.contact.endpoint).origin;
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self' ${contactOrigin}`,
  "object-src 'none'",
  "base-uri 'self'",
  `form-action 'self' ${contactOrigin}`,
].join('; ');
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={site.themeColor} />
    <SeoHead title={title} description={description} type={type} person={person} noindex={noindex} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: updates`} href={url('rss.xml')} />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <TopBar view={view} />
    <slot />
    <SiteFooter />
  </body>
</html>
