---
import { buildInfo } from '@/config/build-info';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-6 px-4 py-16 sm:px-8">
    <p class="font-mono text-[length:var(--text-sm-fluid)] text-text-muted">sohan-cluster</p>
    <h1 class="text-[length:var(--text-display-fluid)] leading-tight font-semibold tracking-tight text-text">
      {site.name}
    </h1>
    <p class="text-[length:var(--text-base-fluid)] text-text-muted">Site under construction.</p>
    <p class="flex items-center gap-2 font-mono text-[length:var(--text-sm-fluid)] text-text-muted">
      <span aria-hidden="true" class="text-status-pending">
        ●
      </span>
      <span data-testid="build-version">
        v{buildInfo.version} ({buildInfo.shortCommit})
      </span>
    </p>
  </main>
</BaseLayout>
