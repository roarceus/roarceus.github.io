---
// `/` (SPEC §4, design doc §4.6). Production shows the pre-rendered hero until the cluster dashboard
// is ready (flag `clusterDashboard`, off in production). With the flag on:
// - 768px and up: hero line, cluster stage, detail panel, and docked terminal (side by side from
//   1024px, stacked below). The page grows to --shell-wide so the map gets the screen; the detail
//   panel stays a fixed, readable column (20rem, 26rem from 1280px).
// - From 1024x700 (the `desk` variant): one screen, no page scroll. Map and panel on top, the terminal
//   docked below, each scrolling in its own box; the footer becomes a status line at the bottom.
// - Phones: the plain layout first, with a "Launch cluster" link to #cluster. CSS :target opens
//   cluster mode (stage, bottom sheet, chip bar) without JavaScript; Back or the browser's back
//   button leaves it.
import ClusterStage from '@/components/cluster/ClusterStage.astro';
import DetailPanel from '@/components/cluster/DetailPanel.astro';
import BottomSheet from '@/components/layout/BottomSheet.astro';
import HomeHero from '@/components/plain/HomeHero.astro';
import TerminalDock from '@/components/terminal/TerminalDock.astro';
import Button from '@/components/ui/Button.astro';
import ExternalLink from '@/components/ui/ExternalLink.astro';
import { focusRing, target } from '@/components/ui/recipes';
import StatusPill from '@/components/ui/StatusPill.astro';
import { buildInfo } from '@/config/build-info';
import { isEnabled } from '@/config/features';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { panelView } from '@/lib/commands/panel';
import { getCluster, getExperience, getProfile, getSnapshot } from '@/lib/content/queries';
import { url } from '@/lib/utils/url';

const dashboard = isEnabled('clusterDashboard');
const { data: profile } = await getProfile();
const cluster = dashboard ? await getCluster() : undefined;
// The Stage 2 cards show live nodes; cordoned eras join the map in Stage 4 (the 2D map, Task 4).
const liveNodes = cluster?.nodes.filter((node) => !node.cordoned) ?? [];
const onMap = new Set(liveNodes.map((node) => node.name));
// The terminal's data file, content-hashed (stage-3 design §5.1); preloaded so the first command
// doesn't wait on it.
const terminal = dashboard
  ? await getSnapshot({ version: buildInfo.version, commit: buildInfo.shortCommit })
  : undefined;
const snapshotHref = terminal && url(`cluster.${terminal.hash}.json`);
// The detail panel opens on the pre-selected role, built from the snapshot it reads after hydration.
const selected = terminal?.snapshot.selected;
const panel =
  terminal && selected !== undefined
    ? panelView(terminal.snapshot, { kind: 'node', name: selected })
    : undefined;
const roles = dashboard ? (await getExperience()).filter(({ data }) => onMap.has(data.node)) : [];
---

<BaseLayout person view="cluster" wide={dashboard} fill={dashboard}>
  {snapshotHref && <link slot="head" rel="preload" as="fetch" crossorigin="anonymous" href={snapshotHref} />}
  {cluster === undefined ? (
    <main id="main">
      <HomeHero />
    </main>
  ) : (
    <main
      id="main"
      class="dashboard mx-auto w-full max-w-(--shell-wide) px-4 py-6 sm:px-8 sm:py-8 desk:flex desk:flex-col desk:py-4"
    >
      <div data-mobile-home class="flex flex-col gap-6 md:hidden">
        <div class="flex flex-col gap-3">
          <h1 class="text-[length:var(--text-display-fluid)] leading-tight font-semibold tracking-tight text-text">
            {profile.name}
          </h1>
          <p class="text-lg text-text">{profile.title}</p>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-sm text-text-muted">
            <span>{profile.location}</span>
            {profile.openToWork && <StatusPill status="running" label="Open to work" />}
          </p>
        </div>
        <Button variant="primary" href="#cluster">
          Launch cluster
        </Button>
        <section aria-labelledby="mobile-experience" class="flex flex-col gap-3">
          <h2 id="mobile-experience" class="font-mono text-sm text-text-muted">
            experience
          </h2>
          <ul role="list" aria-label="Experience" class="flex flex-col gap-3">
            {roles.map(({ data }) => (
              <li class="rounded-lg border border-border bg-surface-1 p-4">
                <p class="font-semibold text-text">{data.role}</p>
                <p class="text-text-muted">{data.org}</p>
              </li>
            ))}
          </ul>
        </section>
        <a
          href={url('plain/')}
          class:list={['link self-start font-mono text-sm', target, 'inline-flex items-center']}
        >
          Full portfolio
        </a>
      </div>

      <div
        id="cluster"
        class="cluster-view flex flex-col gap-4 max-md:hidden max-md:target:flex lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-6 xl:grid-cols-[minmax(0,1fr)_26rem] desk:min-h-0 desk:flex-1 desk:grid-rows-[auto_minmax(0,1fr)_auto_auto] desk:gap-4"
      >
        <div class="flex items-center justify-between gap-3 md:hidden">
          <p class="font-mono text-sm text-text-muted">sohan-cluster</p>
          <a
            href={url()}
            class:list={[
              'link inline-flex items-center rounded-md px-2 font-mono text-sm',
              target,
              focusRing,
            ]}
          >
            Back
          </a>
        </div>
        <div class="flex flex-col gap-1 lg:col-span-2 desk:flex-row desk:flex-wrap desk:items-baseline desk:gap-x-4">
          <!-- Only one h1 is ever displayed: this one, or the phone layout's when cluster mode is closed. -->
          <h1 class="text-[length:var(--text-h2-fluid)] leading-tight font-semibold text-text">
            {profile.name}
          </h1>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-text-muted">
            <span>
              {profile.title}, {profile.location}
            </span>
            {profile.openToWork && <StatusPill status="running" label="Open to work" />}
          </p>
        </div>
        <ClusterStage
          nodes={liveNodes}
          unscheduled={cluster.unscheduled}
          selected={cluster.selected?.data.node}
        />
        {panel && (
          <BottomSheet class="desk:flex desk:min-h-0 desk:flex-col">
            <DetailPanel view={panel} />
          </BottomSheet>
        )}
        {terminal && snapshotHref && (
          <div class="lg:col-span-2">
            <TerminalDock snapshot={terminal.snapshot} snapshotHref={snapshotHref} />
          </div>
        )}
        <p
          data-status-line
          class="hidden flex-wrap items-center gap-x-4 font-mono text-sm text-text-muted lg:col-span-2 desk:flex"
        >
          <span>
            v{buildInfo.version} ({buildInfo.shortCommit})
          </span>
          <ExternalLink href={site.repo}>Source on GitHub</ExternalLink>
        </p>
      </div>
    </main>
  )}
</BaseLayout>

<style>
  /* In cluster mode the phone's plain layout steps aside. */
  .dashboard:has(#cluster:target) [data-mobile-home] {
    display: none;
  }
</style>
