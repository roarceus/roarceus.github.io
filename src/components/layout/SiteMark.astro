---
// Original site mark: a flat node hexagon with a status dot and my initials. Deliberately not
// the Kubernetes helm wheel or anything close to it (SPEC §5 trademarks). public/favicon.svg uses the
// same geometry. Decorative: the link around it carries the name.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 64 64"
  class:list={['shrink-0', className]}
  fill="none"
  stroke-linejoin="round"
>
  <polygon
    points="32,4 56,18 56,46 32,60 8,46 8,18"
    class="fill-surface-2 stroke-accent-soft"
    stroke-width="4"
  ></polygon>
  <circle cx="52" cy="14" r="7" class="fill-status-running stroke-bg" stroke-width="3"></circle>
  <text x="32" y="40.5" text-anchor="middle" class="fill-text font-mono" font-size="21" font-weight="700">
    SP
  </text>
</svg>
