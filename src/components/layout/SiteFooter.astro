---
import ExternalLink from '@/components/ui/ExternalLink.astro';
import { buildInfo } from '@/config/build-info';
import { site } from '@/config/site';

interface Props {
  /** Match a full-width page (the cluster dashboard) instead of the text width. */
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer class="mt-16 border-t border-border">
  <div
    class:list={[
      'mx-auto flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-6 font-mono text-sm text-text-muted sm:px-8',
      wide ? 'max-w-(--shell-wide)' : 'max-w-6xl',
    ]}
  >
    <span data-testid="build-version">
      v{buildInfo.version} ({buildInfo.shortCommit})
    </span>
    <ExternalLink href={site.repo} class="print:hidden">
      Source on GitHub
    </ExternalLink>
  </div>
</footer>
