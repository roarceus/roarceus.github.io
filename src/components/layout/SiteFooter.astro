---
import ExternalLink from '@/components/ui/ExternalLink.astro';
import { buildInfo } from '@/config/build-info';
import { site } from '@/config/site';
---

<footer class="mt-16 border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-6 font-mono text-sm text-text-muted sm:px-8">
    <span data-testid="build-version">
      v{buildInfo.version} ({buildInfo.shortCommit})
    </span>
    <ExternalLink href={site.repo} class="print:hidden">
      Source on GitHub
    </ExternalLink>
  </div>
</footer>
