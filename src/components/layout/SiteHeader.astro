---
// Always-visible simple controls (SPEC §4). Stage 2 replaces this with the full top bar and adds
// the Plain view / Cluster view toggle once the cluster view exists.
import { getProfile } from '@/lib/content/queries';
import { url } from '@/lib/utils/url';

const { data: profile } = await getProfile();
const linkClass =
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded px-3 text-text hover:text-accent-soft';
---

<header class="border-b border-border print:hidden">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 px-4 sm:px-8">
    <a href={url()} class:list={[linkClass, '-ml-3 font-mono font-semibold']}>
      {profile.name}
    </a>
    <nav aria-label="Site">
      <ul role="list" class="flex flex-wrap items-center gap-1 font-mono text-sm">
        <li>
          <a href={url(profile.resume)} class={linkClass}>
            Resume
          </a>
        </li>
        <li>
          <a href={url('plain/#contact')} class={linkClass}>
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
