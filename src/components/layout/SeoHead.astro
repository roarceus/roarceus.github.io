---
// Search and share metadata (SPEC §2, plan D6). Canonical and share URLs always point at
// production, even on PR previews. Previews and noindex pages (404, thank-you) are kept out of
// search; noindex pages also skip the canonical, which would contradict it (and on the 404 page
// name a URL that doesn't exist).
import { site } from '@/config/site';
import { getProfile } from '@/lib/content/queries';
import { isPreviewBase, jsonLdScript, personJsonLd } from '@/lib/seo/meta';
import { productionUrl } from '@/lib/utils/url';

interface Props {
  title: string;
  description: string;
  /** Projects and updates are articles; everything else is the website. */
  type: 'website' | 'article';
  /** Adds the schema.org Person (home and the plain view). */
  person: boolean;
  noindex: boolean;
}

const { title, description, type, person, noindex } = Astro.props;
const base = import.meta.env.BASE_URL;
// The page path without the preview base, so a preview page names its production URL.
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : '';
const canonical = productionUrl(site.url, path);
const image = productionUrl(site.url, 'og-image.png');
const imageAlt = `${site.name}, ${site.title}`;

let jsonLd: string | undefined;
if (person) {
  const { data } = await getProfile();
  jsonLd = jsonLdScript(
    personJsonLd({
      name: data.name,
      jobTitle: data.title,
      url: productionUrl(site.url),
      address: data.location,
      sameAs: [data.links.github, data.links.linkedin],
    }),
  );
}
---

<title>{title}</title>
<meta name="description" content={description} />
{(noindex || isPreviewBase(base)) && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
