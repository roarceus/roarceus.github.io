---
// The detail panel (design doc stage-3 §5.5): an island that opens on the pre-selected role (SPEC §9),
// rendered on the server from the same view `describe` builds, so no-JS and first paint are complete
// and the hydrated panel matches. After hydration it follows the selection.
import type { PanelView } from '@/lib/commands/panel';
import { url } from '@/lib/utils/url';

import { DetailPanel } from './DetailPanel';

interface Props {
  view: PanelView;
}

const { view } = Astro.props;
---

<DetailPanel client:idle initial={view} base={url()} />
