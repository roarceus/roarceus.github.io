---
// The cluster stage (design doc §4.6): a fixed slot that holds the static node cards now, the SVG map
// in Stage 4, and the WebGL scene in Stage 8 (data-renderer), so swapping the renderer never moves
// the layout. Built from content only. Scene colors (--scene-*) are allowed here (ADR 0002).
import { focusRing } from '@/components/ui/recipes';
import StatusPill from '@/components/ui/StatusPill.astro';
import type { ClusterNode, Pod } from '@/lib/content/cluster';
import { url } from '@/lib/utils/url';

interface Props {
  nodes: readonly ClusterNode[];
  unscheduled: readonly Pod[];
  /** Node of the pre-selected role. */
  selected?: string | undefined;
}

const { nodes, unscheduled, selected } = Astro.props;
const podCount = nodes.reduce((sum, node) => sum + node.pods.length, 0) + unscheduled.length;
const section = (role: ClusterNode['role']) => (role === 'education' ? 'education' : 'experience');
const phase = (pod: Pod) => pod.phase.toLowerCase() as 'running' | 'pending' | 'completed';
const podLink = `link ${focusRing} inline-flex min-h-11 items-center break-all font-mono text-sm`;
---

<!-- On one-screen desktops the map scrolls inside itself, so it takes focus for the arrow keys. -->
<section
  aria-label="Cluster map"
  data-renderer="static"
  tabindex="0"
  class:list={[
    'relative flex min-h-[24rem] flex-col rounded-lg border border-border bg-(--scene-bg) lg:min-h-[28rem] desk:min-h-0 desk:overflow-auto',
    focusRing,
  ]}
>
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-border px-4 py-3 font-mono text-sm text-text-muted">
    <h2 id="cluster-heading" tabindex="-1" class:list={['font-mono text-sm font-normal', focusRing]}>
      namespace: career
    </h2>
    <p>
      {nodes.length}/{nodes.length} nodes ready, {podCount} pods
    </p>
  </header>

  <ul
    role="list"
    aria-label="Nodes"
    class="grid flex-1 content-start gap-3 p-4 sm:grid-cols-2 xl:grid-cols-3"
  >
    {nodes.map((node) => (
      <li
        data-node={node.name}
        aria-current={node.name === selected ? 'true' : undefined}
        class:list={[
          'flex flex-col gap-2 rounded-lg border p-4',
          node.name === selected
            ? 'border-accent-soft bg-(--scene-platform-selected)'
            : 'border-(--scene-platform-edge) bg-(--scene-platform)',
        ]}
      >
        <p class="flex flex-wrap items-center justify-between gap-2">
          <a href={url(`plain/#${section(node.role)}`)} class:list={[podLink, 'font-semibold text-text']}>
            {node.name}
          </a>
          <StatusPill status="running" label="Ready" />
        </p>
        <p class="font-mono text-xs text-text">
          role={node.role}
          <span class="sr-only">, {node.label}</span>
        </p>
        {node.pods.length > 0 ? (
          <ul role="list" aria-label={`Pods on ${node.name}`} class="flex flex-col">
            {node.pods.map((pod) => (
              <li class="flex flex-wrap items-center justify-between gap-x-2">
                <a href={url(`projects/${pod.slug}/`)} class={podLink}>
                  {pod.slug}
                </a>
                <StatusPill status={phase(pod)} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="font-mono text-xs text-text">No pods</p>
        )}
      </li>
    ))}
  </ul>

  {unscheduled.length > 0 && (
    <div class="border-t border-border px-4 py-3">
      <p class="font-mono text-xs text-text-muted">unscheduled</p>
      <ul role="list" aria-label="Unscheduled pods" class="flex flex-wrap gap-x-6">
        {unscheduled.map((pod) => (
          <li class="flex items-center gap-2">
            <a href={url(`projects/${pod.slug}/`)} class={podLink}>
              {pod.slug}
            </a>
            <StatusPill status={phase(pod)} />
          </li>
        ))}
      </ul>
    </div>
  )}

  <ul role="list" aria-label="Legend" class="flex flex-wrap gap-2 border-t border-border px-4 py-3">
    <li>
      <StatusPill status="running" />
    </li>
    <li>
      <StatusPill status="pending" />
    </li>
    <li>
      <StatusPill status="completed" />
    </li>
  </ul>
</section>

<script>
  // Cluster mode on phones opens through the #cluster link (CSS :target, no JS needed). With JS, move
  // focus to the stage heading so keyboard and screen reader users land in the cluster.
  function focusStage(): void {
    if (window.location.hash === '#cluster') document.getElementById('cluster-heading')?.focus();
  }
  window.addEventListener('hashchange', focusStage);
  focusStage();
</script>
