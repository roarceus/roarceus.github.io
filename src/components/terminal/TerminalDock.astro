---
// The docked terminal (design doc stage-3 §5.4). The island renders on the server with today's
// `kubectl get experience` and the chips as plain-view links, so no-JS and first paint match Stage 2;
// it hydrates when the browser is idle and adds the input.
import { execute } from '@/lib/commands/run';
import type { ClusterSnapshot } from '@/lib/content/snapshot';
import { parse } from '@/lib/parser/parse';
import { url } from '@/lib/utils/url';

import { Terminal } from './Terminal';

interface Props {
  snapshot: ClusterSnapshot;
  /** `url('cluster.<hash>.json')`. */
  snapshotHref: string;
}

const { snapshot, snapshotHref } = Astro.props;

const FIRST = 'kubectl get experience';
const parsed = parse(FIRST);
if (!parsed.ok) throw new Error(parsed.error);
const base = url();
const result = await execute(parsed.command, { snapshot, build: snapshot.build, base, now: new Date() });

const chips = [
  'kubectl get pods -n projects',
  'kubectl top skills',
  'kubectl get certificates',
  'kubectl logs updates',
  'help',
];
---

<Terminal
  client:idle
  snapshotHref={snapshotHref}
  build={snapshot.build}
  base={base}
  initial={{ input: FIRST, result }}
  chips={chips}
/>
