---
// Status is always spelled out, and a shape repeats it, so color only reinforces it (SPEC §5 state
// language, WCAG 1.4.1). Shapes follow the cluster legend: running filled circle, pending half
// circle, failed cross, completed ring.
type Status = 'running' | 'completed' | 'pending' | 'failed' | 'in-progress' | 'issued';
type Shape = 'filled' | 'half' | 'cross' | 'ring';

interface Props {
  status: Status;
  /** Overrides the default label, e.g. "Open to work". */
  label?: string;
}

const LABELS: Record<Status, string> = {
  running: 'Running',
  completed: 'Completed',
  pending: 'Pending',
  failed: 'Failed',
  'in-progress': 'In progress',
  issued: 'Issued',
};

const LOOK: Record<Status, { shape: Shape; color: string; fill: string }> = {
  running: { shape: 'filled', color: 'text-status-running', fill: 'bg-status-running-soft' },
  issued: { shape: 'filled', color: 'text-status-running', fill: 'bg-status-running-soft' },
  pending: { shape: 'half', color: 'text-status-pending', fill: 'bg-status-pending-soft' },
  'in-progress': { shape: 'half', color: 'text-status-pending', fill: 'bg-status-pending-soft' },
  failed: { shape: 'cross', color: 'text-status-failed', fill: 'bg-status-failed-soft' },
  completed: { shape: 'ring', color: 'text-status-completed', fill: 'bg-status-completed-soft' },
};

const { status, label = LABELS[status] } = Astro.props;
const { shape, color, fill } = LOOK[status];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-xs whitespace-nowrap text-text',
    fill,
  ]}
>
  <svg
    aria-hidden="true"
    data-shape={shape}
    viewBox="0 0 10 10"
    class:list={['size-2.5 shrink-0', color]}
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    {shape === 'filled' && <circle cx="5" cy="5" r="4" fill="currentColor" />}
    {shape === 'half' && (
      <>
        <circle cx="5" cy="5" r="4" />
        <path d="M5 1a4 4 0 0 1 0 8z" fill="currentColor" stroke="none" />
      </>
    )}
    {shape === 'cross' && <path d="m2 2 6 6M8 2 2 8" stroke-linecap="round" />}
    {shape === 'ring' && <circle cx="5" cy="5" r="4" />}
  </svg>
  {label}
</span>
