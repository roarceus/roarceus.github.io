---
// Status is always spelled out, and a shape repeats it, so color only reinforces it (SPEC §5 state
// language, WCAG 1.4.1). Shapes follow the cluster legend: running filled circle, pending half
// circle, failed cross, completed ring.
import { STATUS_LABELS, STATUS_LOOK, STATUS_PILL, type Status } from './recipes';

interface Props {
  status: Status;
  /** Overrides the default label, e.g. "Open to work". */
  label?: string;
}

const { status, label = STATUS_LABELS[status] } = Astro.props;
const { shape, color, fill } = STATUS_LOOK[status];
---

<span class:list={[STATUS_PILL, fill]}>
  <svg
    aria-hidden="true"
    data-shape={shape}
    viewBox="0 0 10 10"
    class:list={['size-2.5 shrink-0', color]}
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    {shape === 'filled' && <circle cx="5" cy="5" r="4" fill="currentColor" />}
    {shape === 'half' && (
      <>
        <circle cx="5" cy="5" r="4" />
        <path d="M5 1a4 4 0 0 1 0 8z" fill="currentColor" stroke="none" />
      </>
    )}
    {shape === 'cross' && <path d="m2 2 6 6M8 2 2 8" stroke-linecap="round" />}
    {shape === 'ring' && <circle cx="5" cy="5" r="4" />}
  </svg>
  {label}
</span>
