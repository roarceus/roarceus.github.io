---
import { plainSections } from '@/config/sections';
---

<nav aria-labelledby="section-nav-label" class="print:hidden">
  <p id="section-nav-label" class="mb-1 font-mono text-xs tracking-wide text-text-muted uppercase">
    On this page
  </p>
  <ul role="list" class="-ml-2 flex flex-wrap gap-x-1 lg:ml-0 lg:flex-col">
    {plainSections.map(({ id, label }) => (
      <li>
        <a
          href={`#${id}`}
          class="inline-flex min-h-11 min-w-11 items-center rounded px-2 font-mono text-sm text-text-muted hover:text-accent-soft lg:-ml-2"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
