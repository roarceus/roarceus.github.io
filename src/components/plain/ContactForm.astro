---
// Works without JavaScript (a plain POST to Web3Forms that redirects to /contact/thanks/). With
// JavaScript, the script below validates inline and sends with fetch, so the visitor stays here.
import { site } from '@/config/site';
import { url } from '@/lib/utils/url';

interface Props {
  /** Shown when sending fails, so the visitor can still reach me. */
  email: string;
}

const { email } = Astro.props;
const redirect = new URL(url('contact/thanks/'), site.url).toString();
const fields = [
  { name: 'name', label: 'Name', type: 'text', autocomplete: 'name' },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
] as const;
const inputClass =
  'min-h-11 w-full rounded-md border border-border bg-surface-1 px-3 py-2 text-base text-text aria-invalid:border-status-failed';
---

<form
  action={site.contact.endpoint}
  method="POST"
  aria-label="Contact form"
  data-contact-form
  data-endpoint={site.contact.endpoint}
  data-access-key={site.contact.accessKey}
  data-email={email}
  class="flex max-w-prose flex-col gap-5"
>
  <input type="hidden" name="access_key" value={site.contact.accessKey} />
  <input type="hidden" name="subject" value="New message from your portfolio" />
  <input type="hidden" name="redirect" value={redirect} />
  <!-- Honeypot: people never see it, bots fill it in. Web3Forms drops those messages too. -->
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  {fields.map((field) => (
    <div class="flex flex-col gap-1.5">
      <label for={`contact-${field.name}`} class="font-mono text-sm text-text">
        {field.label}
      </label>
      <input
        id={`contact-${field.name}`}
        name={field.name}
        type={field.type}
        autocomplete={field.autocomplete}
        required
        maxlength={field.name === 'name' ? 100 : undefined}
        aria-describedby={`contact-${field.name}-error`}
        class={inputClass}
      />
      <p id={`contact-${field.name}-error`} class="text-sm text-status-failed" hidden />
    </div>
  ))}
  <div class="flex flex-col gap-1.5">
    <label for="contact-message" class="font-mono text-sm text-text">
      Message
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      minlength="10"
      maxlength="5000"
      aria-describedby="contact-message-error"
      class={inputClass}
    ></textarea>
    <p id="contact-message-error" class="text-sm text-status-failed" hidden></p>
  </div>

  <div class="flex flex-col gap-3">
    <button
      type="submit"
      class="inline-flex min-h-11 items-center justify-center self-start rounded-md bg-accent px-5 font-mono text-sm font-semibold text-on-accent hover:underline disabled:cursor-wait disabled:opacity-70"
    >
      Send message
    </button>
    <p class="text-sm text-text-muted">Your message goes to my inbox through Web3Forms.</p>
    <div role="status" data-status class="text-text"></div>
  </div>
</form>

<script>
  import { contactPayload, sendContact, toSubmitResult } from '@/lib/contact/submit';
  import { validateContact, type ContactField } from '@/lib/contact/validate';

  const FIELDS: ContactField[] = ['name', 'email', 'message'];
  const LABEL = 'Send message';

  function setUp(form: HTMLFormElement): void {
    const { endpoint = '', accessKey = '', email = '' } = form.dataset;
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!status || !button) return;
    form.noValidate = true;
    let sending = false;

    const control = (name: ContactField) =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
    const errorFor = (name: ContactField) => form.querySelector<HTMLElement>(`#contact-${name}-error`);

    function showErrors(errors: Partial<Record<ContactField, string>>): void {
      for (const name of FIELDS) {
        const message = errors[name];
        const error = errorFor(name);
        if (error) {
          error.textContent = message ?? '';
          error.hidden = !message;
        }
        if (message) control(name)?.setAttribute('aria-invalid', 'true');
        else control(name)?.removeAttribute('aria-invalid');
      }
      const first = FIELDS.find((name) => errors[name]);
      if (first) control(first)?.focus();
    }

    const showStatus = (result: ReturnType<typeof toSubmitResult>): void => {
      if (result === 'sent') {
        status.textContent = "Thanks, your message is on its way. I'll reply by email.";
      } else if (result === 'invalid') {
        status.textContent =
          "Something in the form wasn't accepted. Please check your details and try again.";
      } else if (result === 'offline') {
        status.textContent =
          "You seem to be offline. Your message is still here, try again when you're back online.";
      } else {
        const link = document.createElement('a');
        link.href = `mailto:${email}`;
        link.className = 'link';
        link.textContent = email;
        status.replaceChildren(
          'Something went wrong on my end. Please try again, or email me at ',
          link,
          '.',
        );
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (sending) return;
      const data = new FormData(form);
      const value = (name: string) => {
        const entry = data.get(name);
        return typeof entry === 'string' ? entry : '';
      };
      const result = validateContact({
        name: value('name'),
        email: value('email'),
        message: value('message'),
        botcheck: value('botcheck'),
      });
      status.textContent = '';

      if (result.kind === 'invalid') {
        showErrors(result.errors);
        return;
      }
      showErrors({});
      if (result.kind === 'spam') {
        form.reset();
        showStatus('sent');
        return;
      }

      sending = true;
      button.disabled = true;
      button.textContent = 'Sending...';
      void sendContact(endpoint, contactPayload(result.value, accessKey)).then((outcome) => {
        const submitResult = toSubmitResult(outcome);
        showStatus(submitResult);
        if (submitResult === 'sent') form.reset();
        sending = false;
        button.disabled = false;
        button.textContent = LABEL;
      });
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach(setUp);
</script>
