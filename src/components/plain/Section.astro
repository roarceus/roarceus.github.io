---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class="scroll-mt-[calc(var(--jumpbar-h)+1rem)] border-t border-border pt-8 lg:scroll-mt-6"
>
  <h2 id={`${id}-heading`} class="mb-4 font-mono text-xl font-semibold text-text">
    {title}
  </h2>
  <slot />
</section>
