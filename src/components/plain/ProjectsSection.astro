---
import ExternalLink from '@/components/ui/ExternalLink.astro';
import StatusPill from '@/components/ui/StatusPill.astro';
import TagList from '@/components/ui/TagList.astro';
import { getProjects } from '@/lib/content/queries';
import { formatRange } from '@/lib/utils/dates';
import { url } from '@/lib/utils/url';

import Section from './Section.astro';

const featured = await getProjects({ featured: true });
const more = await getProjects({ featured: false });
const linkClass = 'inline-flex min-h-11 items-center';
---

<Section id="projects" title="Projects">
  <h3 class="sr-only">Featured projects</h3>
  <ul role="list" aria-label="Featured projects" class="grid gap-4">
    {featured.map(({ id, data }) => (
      <li class="flex flex-col gap-3 rounded-lg border border-border bg-surface-1 p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h4 class="text-lg font-semibold text-text">{data.name}</h4>
          <StatusPill status={data.status} />
        </div>
        <p class="text-text-muted">{data.tagline}</p>
        {data.start && <p class="font-mono text-sm text-text-muted">{formatRange(data.start, data.end)}</p>}
        <TagList items={data.tech} label={`Tech used in ${data.name}`} />
        <p class="flex flex-wrap gap-x-5 font-mono text-sm">
          <a href={url(`projects/${id}/`)} class:list={['link', linkClass]}>
            Details<span class="sr-only"> on {data.name}</span>
          </a>
          {data.links.repo && (
            <ExternalLink href={data.links.repo} class={linkClass}>
              Source<span class="sr-only"> for {data.name}</span>
            </ExternalLink>
          )}
          {data.links.demo && (
            <ExternalLink href={data.links.demo} class={linkClass}>
              Demo<span class="sr-only"> of {data.name}</span>
            </ExternalLink>
          )}
        </p>
      </li>
    ))}
  </ul>

  <h3 class="mt-10 mb-4 font-mono text-base font-semibold text-text">More projects</h3>
  <ul role="list" aria-label="More projects" class="flex flex-col divide-y divide-border">
    {more.map(({ id, data }) => (
      <li class="flex flex-col gap-1 py-3">
        <p class="flex flex-wrap items-baseline gap-x-3">
          <span class="font-semibold text-text">{data.name}</span>
          {data.start && (
            <span class="font-mono text-xs text-text-muted">{formatRange(data.start, data.end)}</span>
          )}
        </p>
        <p class="text-text-muted">{data.tagline}</p>
        <p class="flex flex-wrap gap-x-5 font-mono text-sm">
          <a href={url(`projects/${id}/`)} class:list={['link', linkClass]}>
            Details<span class="sr-only"> on {data.name}</span>
          </a>
          {data.links.repo && (
            <ExternalLink href={data.links.repo} class={linkClass}>
              Source<span class="sr-only"> for {data.name}</span>
            </ExternalLink>
          )}
        </p>
      </li>
    ))}
  </ul>
</Section>
