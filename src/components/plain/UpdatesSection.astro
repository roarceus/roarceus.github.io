---
import { getUpdates } from '@/lib/content/queries';
import { url } from '@/lib/utils/url';

import Section from './Section.astro';
import UpdateDate from './UpdateDate.astro';

// The latest few; the full list lives at /updates/.
const LATEST = 3;
const updates = (await getUpdates()).slice(0, LATEST);
---

<Section id="updates" title="Updates">
  <ol role="list" class="flex flex-col gap-5">
    {updates.map(({ id, data }) => (
      <li class="flex flex-col gap-1">
        <UpdateDate date={data.date} />
        <a href={url(`updates/${id}/`)} class="link self-start font-semibold">
          {data.title}
        </a>
        <p class="text-text-muted">{data.summary}</p>
      </li>
    ))}
  </ol>
  <p class="mt-4 font-mono text-sm">
    <a href={url('updates/')} class="link inline-flex min-h-11 items-center">
      All updates
    </a>
  </p>
</Section>
