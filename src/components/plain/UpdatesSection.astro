---
import { getUpdates } from '@/lib/content/queries';
import { formatYearMonth } from '@/lib/utils/dates';

import Section from './Section.astro';

// The latest few; the full list and per-update pages arrive with /updates/ (Stage 1 PR 4).
const LATEST = 5;
const updates = (await getUpdates()).slice(0, LATEST);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Section id="updates" title="Updates">
  <ol role="list" class="flex flex-col gap-5">
    {updates.map(({ data }) => (
      <li class="flex flex-col gap-1">
        <time datetime={isoDate(data.date)} class="font-mono text-sm text-text-muted">
          {formatYearMonth(isoDate(data.date).slice(0, 7))}
        </time>
        <p class="font-semibold text-text">{data.title}</p>
        <p class="text-text-muted">{data.summary}</p>
      </li>
    ))}
  </ol>
</Section>
