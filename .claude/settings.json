{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * :main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(gh pr merge*)",
      "Bash(gh api * /merge*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push --no-verify*)",
      "PowerShell(git push * --no-verify*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push * HEAD:main*)",
      "PowerShell(git push * :main*)",
      "PowerShell(git push * refs/heads/main*)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git commit * --no-verify*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh api * /merge*)"
    ]
  }
}
